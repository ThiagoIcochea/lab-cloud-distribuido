{
  "displayName": "Lab · Monitoreo de infraestructura",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      { "width": 6, "height": 4, "widget": { "title": "CPU de las VM (utilización)",
        "xyChart": { "dataSets": [ { "plotType": "LINE", "timeSeriesQuery": { "timeSeriesFilter": {
          "filter": "metric.type=\"compute.googleapis.com/instance/cpu/utilization\" resource.type=\"gce_instance\"",
          "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_MEAN" } } } } ] } } },
      { "xPos": 6, "width": 6, "height": 4, "widget": { "title": "Tráfico de red recibido (bytes)",
        "xyChart": { "dataSets": [ { "plotType": "LINE", "timeSeriesQuery": { "timeSeriesFilter": {
          "filter": "metric.type=\"compute.googleapis.com/instance/network/received_bytes_count\" resource.type=\"gce_instance\"",
          "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE" } } } } ] } } },
      { "yPos": 4, "width": 12, "height": 4, "widget": { "title": "Uptime check del servicio web",
        "xyChart": { "dataSets": [ { "plotType": "LINE", "timeSeriesQuery": { "timeSeriesFilter": {
          "filter": "metric.type=\"monitoring.googleapis.com/uptime_check/check_passed\" resource.type=\"uptime_url\"",
          "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_FRACTION_TRUE",
                           "crossSeriesReducer": "REDUCE_MEAN", "groupByFields": [ "resource.label.host" ] } } } } ] } } }
    ]
  }
}
